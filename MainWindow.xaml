<Window x:Class="WpfApp3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Фігури Ліссажу"
        Width="1200"
        Height="750">

    <Grid Margin="15">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        
        <StackPanel Grid.Column="0"
                    Margin="0,0,15,0">

            <TextBlock Text="Фігури Ліссажу"
                       FontSize="26"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            
            <TextBlock Text="Амплітуда Ax (од.)"/>

            <TextBox Text="{Binding AmplitudeX,
                                    UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,5,0,12"/>

            
            <TextBlock Text="Амплітуда Ay (од.)"/>

            <TextBox Text="{Binding AmplitudeY,
                                    UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,5,0,12"/>

            
            <TextBlock Text="Частота fx (Гц)"/>

            <TextBox Text="{Binding FrequencyX,
                                    UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,5,0,12"/>

            
            <TextBlock Text="Частота fy (Гц)"/>

            <TextBox Text="{Binding FrequencyY,
                                    UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,5,0,12"/>

            
            <TextBlock Text="Фаза φx (градуси)"/>

            <Slider Minimum="0"
                    Maximum="360"
                    Value="{Binding PhaseX,
                                    UpdateSourceTrigger=PropertyChanged}"
                    Margin="0,5,0,0"/>

            <TextBlock Text="{Binding PhaseX, StringFormat=Фаза X: {0:F1}°}"
                       Margin="0,0,0,12"/>

            
            <TextBlock Text="Фаза φy (градуси)"/>

            <Slider Minimum="0"
                    Maximum="360"
                    Value="{Binding PhaseY,
                                    UpdateSourceTrigger=PropertyChanged}"
                    Margin="0,5,0,0"/>

            <TextBlock Text="{Binding PhaseY, StringFormat=Фаза Y: {0:F1}°}"
                       Margin="0,0,0,12"/>

            
            <TextBlock Text="Кількість точок (мін. 20)"/>

            <TextBox Text="{Binding PointsCount,
                                    UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,5,0,15"/>

            
            <Button Content="Побудувати"
                    Command="{Binding BuildCommand}"
                    Height="40"
                    FontSize="16"/>

            
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="Red"
                       TextWrapping="Wrap"
                       Margin="0,15,0,0"/>
            <Button Content="Почати анімацію"
                    Command="{Binding StartAnimationCommand}"
                    Height="40"
                    FontSize="16"/>
            <Button Content="Зупинити анімацію"
                    Command="{Binding StopAnimationCommand}"
                    Height="40"
                    FontSize="16"/>

            <Button Content="Зберегти JSON"
                    Command="{Binding SaveCommand}"
                    Height="40"
                    FontSize="16"/>

            <Button Content="Завантажити JSON"
                    Command="{Binding LoadCommand}"
                    Height="40"
                    FontSize="16"/>

        </StackPanel>


        
        <Border Grid.Column="1"
                BorderBrush="Gray"
                BorderThickness="1"
                Background="White">

            <Viewbox Stretch="Uniform">

                <Canvas Width="600"
                        Height="600"
                        Background="White">

                    
                    <Line X1="0"
                          Y1="300"
                          X2="600"
                          Y2="300"
                          Stroke="LightGray"
                          StrokeThickness="1"/>

                    <Line X1="300"
                          Y1="0"
                          X2="300"
                          Y2="600"
                          Stroke="LightGray"
                          StrokeThickness="1"/>

                    
                    <Polyline Points="{Binding ScreenPoints}"
                              Stroke="Blue"
                              StrokeThickness="2"
                              Fill="Transparent"/>

                </Canvas>

            </Viewbox>

        </Border>

    </Grid>

</Window>